<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Labels — Yearly from Weekly • Enhanced Debt & Budget Engine</title>
<style>
  :root { --bg:#0f172a; --panel:#111827; --ink:#e5e7eb; --muted:#94a3b8; --line:#1f2937; }
  html,body { margin:0; padding:0; background:var(--bg); color:var(--ink); font:14px/1.45 system-ui, -apple-system, Segoe UI, Roboto, sans-serif; }
  header { padding:16px 24px; border-bottom:1px solid var(--line); }
  h1 { margin:0 0 6px; font-size:22px; }
  .muted { color:var(--muted); font-size:12px; }
  main { padding:16px 24px; max-width:1400px; margin:0 auto; }
  .row { display:grid; grid-template-columns: repeat(12, 1fr); gap:12px; }
  .col-3 { grid-column: span 3; } .col-4 { grid-column: span 4; } .col-5 { grid-column: span 5; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:12px; }
  label.small { display:block; text-transform:uppercase; letter-spacing:.06em; font-size:11px; color:var(--muted); margin:0 0 6px; }
  select,input { width:100%; background:#0b1220; color:var(--ink); border:1px solid var(--line); border-radius:10px; padding:8px 10px; }
  .controls .col-3, .controls .col-4, .controls .col-5 { min-width:220px; }
  .btn { padding:8px 12px; border-radius:10px; border:1px solid var(--line); background:#0b1220; color:var(--ink); cursor:pointer; }
  .btn:hover { background:#12213d; }
  .grid3 { display:grid; grid-template-columns: repeat(3, 1fr); gap:12px; }
  .card { background:#0b1220; border:1px solid var(--line); border-radius:12px; padding:12px; }
  .card .k { font-size:11px; color:var(--muted); text-transform:uppercase; }
  .card .v { font-size:18px; font-weight:600; }
  table { width:100%; border-collapse: collapse; font-size:13px; }
  thead th { position:sticky; top:0; background:#0b1220cc; backdrop-filter: blur(4px); border-bottom:1px solid var(--line); text-transform:uppercase; letter-spacing:.06em; font-size:11px; text-align:left; padding:10px; cursor:default; }
  thead th.sort { cursor:pointer; }
  tbody td { border-bottom:1px solid var(--line); padding:8px 10px; }
  tbody tr:hover { background:#0b1220; }
  .mono { font-variant-numeric: tabular-nums; }
  .scroll { overflow:auto; max-height:60vh; }
  .flex { display:flex; gap:8px; align-items:center; }
  .warn { color:#fcd34d; }
  #noLabels { display:none; margin-top:8px; color:#fca5a5; }
</style>
</head>
<body>
  <header>
    <div class="flex" style="justify-content:space-between;">
