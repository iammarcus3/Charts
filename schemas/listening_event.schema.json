{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema": { "type": "string" },
    "exported_at": { "type": "string", "format": "date-time" },
    "username": { "type": "string" },
    "total": { "type": "integer" },
    "range": {
      "type": "object",
      "properties": {
        "from": { "type": "integer" },
        "to": { "type": "integer" }
      }
    },
    "scrobbles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artist": { "type": "string" },
          "track": { "type": "string" },
          "album": { "type": "string" },
          "timestamp": { "type": "integer" }
        },
        "required": ["artist", "track", "timestamp"]
      }
    }
  },
  "required": ["schema", "scrobbles"]
}
